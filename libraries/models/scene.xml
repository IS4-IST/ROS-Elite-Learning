<!-- Scene for the Elite EC66: floor, lights, cameras and joint position servos.
     Units: SI (m, kg, s), joint angles in radians. -->
<mujoco model="ec66_scene">
  <include file="ec66/ec66.xml"/>
  <compiler meshdir="ec66/meshes"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.5 0.5 0.5"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.25 0.27 0.30" rgb2="0.20 0.22 0.25"
             width="512" height="512" mark="edge" markrgb="0.35 0.37 0.40"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.65 0.75" rgb2="0.1 0.1 0.15" width="256" height="256"/>
  </asset>

  <worldbody>
    <light name="key" pos="1.2 -1.0 2.5" dir="-0.4 0.3 -1" directional="false" castshadow="true"/>
    <light name="fill" pos="-1.5 1.0 2.0" dir="0.5 -0.3 -1" castshadow="false" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="grid"/>
    <!-- fixed camera looking at the arm from the front-right -->
    <camera name="scene_cam" pos="1.05 -0.95 0.85" xyaxes="0.743 0.669 -0.000 -0.253 0.281 0.926" fovy="50"/>
  </worldbody>

  <!-- Position servos: ctrl = target joint angle (rad). Stiff enough to settle within 0.01 deg in ~0.2 s with
       gravity compensation (applied by the emulator through qfrc_applied). Not identified from the real arm. -->
  <actuator>
    <position name="act1" joint="joint1" kp="20000" kv="1000" ctrlrange="-6.2832 6.2832" forcerange="-150 150"/>
    <position name="act2" joint="joint2" kp="20000" kv="1000" ctrlrange="-3.14 0"       forcerange="-150 150"/>
    <position name="act3" joint="joint3" kp="20000" kv="1000" ctrlrange="-2.7925 2.7925" forcerange="-150 150"/>
    <position name="act4" joint="joint4" kp="5000" kv="100"  ctrlrange="-6.2832 6.2832" forcerange="-28 28"/>
    <position name="act5" joint="joint5" kp="5000" kv="100"  ctrlrange="-6.2832 6.2832" forcerange="-28 28"/>
    <position name="act6" joint="joint6" kp="5000" kv="100"  ctrlrange="-6.2832 6.2832" forcerange="-28 28"/>
  </actuator>

  <!-- Home pose used by the examples (rad): EC66 "P000" = [0, -90, 90, -90, 90, 0] deg -->
  <keyframe>
    <key name="home" qpos="0 -1.5708 1.5708 -1.5708 1.5708 0" ctrl="0 -1.5708 1.5708 -1.5708 1.5708 0"/>
  </keyframe>
</mujoco>
