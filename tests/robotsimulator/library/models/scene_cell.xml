<!-- scene.xml plus a small work cell, for trying the planner and the twin's checks.
     Load the same file in all three programs:
       ./build/simulator/simulator library/models/scene_cell.xml
       ./build/digitaltwin/digitaltwin library/models/scene_cell.xml --ip 127.0.0.1
       ./build/planner/planner --model library/models/scene_cell.xml --goal ...
     Positions in metres, robot base at the origin, "home" TCP at about (0.50, 0.12, 0.43).
     Every geom here collides (default contype/conaffinity) and is drawn (group 0). -->
<mujoco model="ec66 cell">
  <include file="scene.xml"/>

  <asset>
    <material name="obstacle" rgba="0.85 0.45 0.2 1"/>
    <material name="table" rgba="0.55 0.42 0.3 1"/>
    <material name="wall" rgba="0.7 0.72 0.75 0.6"/>
  </asset>

  <worldbody>
    <!-- in front, right: blocks the plain joint-1 turn from home to -90 deg -->
    <geom name="pillar" type="box" pos="0.42 -0.30 0.33" size="0.08 0.08 0.33" material="obstacle"/>

    <!-- left: a table, top at 30 cm; the arm can work above it -->
    <geom name="table_top" type="box" pos="0.05 0.55 0.29" size="0.35 0.20 0.015" material="table"/>
    <geom name="table_leg1" type="box" pos="-0.27 0.38 0.14" size="0.02 0.02 0.14" material="table"/>
    <geom name="table_leg2" type="box" pos="0.37 0.38 0.14" size="0.02 0.02 0.14" material="table"/>
    <geom name="table_leg3" type="box" pos="-0.27 0.72 0.14" size="0.02 0.02 0.14" material="table"/>
    <geom name="table_leg4" type="box" pos="0.37 0.72 0.14" size="0.02 0.02 0.14" material="table"/>
    <geom name="box_on_table" type="box" pos="0.15 0.52 0.37" size="0.06 0.06 0.065" material="obstacle"/>

    <!-- behind: a wall, so the arm can't swing through the back -->
    <geom name="wall" type="box" pos="-0.45 0 0.6" size="0.02 0.9 0.6" material="wall"/>

    <!-- overhead: a beam across the workspace at 1.05 m, against stretched-up poses -->
    <geom name="beam" type="box" pos="0.1 0 1.05" size="0.05 0.9 0.05" material="obstacle"/>
  </worldbody>
</mujoco>
