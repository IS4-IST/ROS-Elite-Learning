<!-- scene.xml plus a pillar between "home" and a 90 deg turn of joint 1.
     For trying the planner: the straight joint move hits it, the planned one doesn't.
       ./build/planner/planner --model library/models/scene_pillar.xml --start home --goal -90 -90 90 -90 90 0
     Load the same file in the simulator and the twin so all three see the same world. -->
<mujoco model="ec66 pillar">
  <include file="scene.xml"/>

  <worldbody>
    <geom name="pillar" type="box" pos="0.42 -0.30 0.33" size="0.08 0.08 0.33" rgba="0.85 0.45 0.2 1"/>
  </worldbody>
</mujoco>
